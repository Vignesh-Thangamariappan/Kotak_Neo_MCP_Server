# Copy this file to `.env` in the same directory and fill in real values
# yourself in a text editor. `.env` is gitignored and is never read by the
# assistant driving this MCP server — only mcp_server.py reads it, locally,
# at process startup.

# From Kotak Neo web portal: Invest > Trade API > API Dashboard > Create Application
KOTAK_CONSUMER_KEY=

# The mobile number registered with your Kotak Neo account
KOTAK_MOBILE_NUMBER=

# Your unique client code (UCC)
KOTAK_UCC=

# Your Kotak Neo trading MPIN
KOTAK_MPIN=

# Optional: the base32 secret shown when you first set up authenticator-app
# 2FA for Kotak Neo (usually shown as a manual setup key alongside the QR
# code). If set, the `login` MCP tool generates the current TOTP code for
# you automatically. If you don't have this, leave it blank and pass the
# current 6-digit code from your authenticator app to the `login` tool's
# `totp` argument each time instead.
KOTAK_TOTP_SECRET=

# Must match the WORKER_API_KEY the neo-worker Docker container was started with.
WORKER_API_KEY=
